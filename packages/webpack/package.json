{
  "name": "@dom-selector/webpack",
  "version": "0.0.1",
  "description": "Webpack plugin for DOM Selector",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "webpack": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "webpack": "^5.99.7"
  },
  "dependencies": {
    "@dom-selector/core": "workspace:*",
    "@dom-selector/overlay-ui": "workspace:*"
  }
}
