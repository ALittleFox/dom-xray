{
  "name": "@dom-xray/core",
  "version": "1.0.0",
  "description": "Core utilities for dom-xray plugins",
  "repository": {
    "type": "git",
    "url": "https://github.com/ALittleFox/dom-xray.git",
    "directory": "packages/core"
  },
  "keywords": [
    "dom-xray",
    "core",
    "source-code-locator",
    "source-code-navigation",
    "babel",
    "vue",
    "svelte",
    "transform",
    "source-code",
    "ai-agent",
    "cursor",
    "claude",
    "opencode"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./loader": {
      "types": "./dist/loader/index.d.ts",
      "import": "./dist/loader/index.js",
      "default": "./dist/loader/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.168",
    "@babel/generator": "^7.29.7",
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@cursor/sdk": "^1.0.17",
    "@opencode-ai/sdk": "^1.16.0",
    "dom-serializer": "^3.1.1",
    "htmlparser2": "^12.0.0",
    "magic-string": "^0.30.21"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^22.15.15",
    "typescript": "^6.0.3"
  }
}
