{
  "name": "@dom-xray/nuxt",
  "version": "1.0.0",
  "description": "Nuxt 3 module for DOM XRay",
  "repository": {
    "type": "git",
    "url": "https://github.com/ALittleFox/dom-xray.git",
    "directory": "packages/nuxt"
  },
  "keywords": [
    "dom-xray",
    "nuxt",
    "nuxt3",
    "module",
    "devtools",
    "source-code-locator",
    "source-code-navigation",
    "code-jump",
    "ai-agent"
  ],
  "type": "module",
  "main": "./dist/module.js",
  "types": "./dist/module.d.ts",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    }
  },
  "files": [
    "dist",
    "runtime",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  },
  "dependencies": {
    "@dom-xray/core": "workspace:*",
    "@dom-xray/overlay-ui": "workspace:*",
    "@nuxt/kit": "^4.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.15",
    "nuxt": "^4.4.7",
    "typescript": "^6.0.3",
    "vite": "^6.0.0"
  }
}
