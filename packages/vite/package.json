{
  "name": "@dom-xray/vite",
  "version": "0.0.1",
  "description": "Vite plugin for DOM XRay",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "vite": "^8.0.16",
    "typescript": "^6.0.3",
    "@types/node": "^22.15.15"
  },
  "dependencies": {
    "@dom-xray/core": "workspace:*",
    "@dom-xray/overlay-ui": "workspace:*"
  }
}
