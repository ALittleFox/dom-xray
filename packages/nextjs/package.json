{
  "name": "@dom-xray/nextjs",
  "version": "1.0.2",
  "description": "Next.js plugin for DOM XRay (supports Turbopack)",
  "repository": {
    "type": "git",
    "url": "https://github.com/ALittleFox/dom-xray.git",
    "directory": "packages/nextjs"
  },
  "keywords": [
    "dom-xray",
    "nextjs",
    "plugin",
    "turbopack",
    "devtools",
    "source-code-locator",
    "source-code-navigation",
    "code-jump",
    "ai-agent"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client-script.d.ts",
      "import": "./dist/client-script.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@dom-xray/core": "workspace:*",
    "@dom-xray/overlay-ui": "workspace:*"
  }
}
