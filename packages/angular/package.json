{
  "name": "@dom-xray/angular",
  "version": "1.0.3",
  "description": "Angular integration for DOM XRay",
  "repository": {
    "type": "git",
    "url": "https://github.com/ALittleFox/dom-xray.git",
    "directory": "packages/angular"
  },
  "keywords": [
    "dom-xray",
    "angular",
    "cli",
    "devtools",
    "source-code-locator",
    "source-code-navigation",
    "code-jump",
    "ai-agent"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dom-xray-ng": "./dist/ng-wrapper.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./patch": {
      "types": "./dist/patch-fs.d.ts",
      "require": "./dist/patch-fs.js",
      "import": "./dist/patch-fs.js",
      "default": "./dist/patch-fs.js"
    },
    "./html-loader": {
      "types": "./dist/html-loader.d.ts",
      "require": "./dist/html-loader.js",
      "import": "./dist/html-loader.js",
      "default": "./dist/html-loader.js"
    },
    "./source-collector": {
      "types": "./dist/source-collector.d.ts",
      "require": "./dist/source-collector.js",
      "import": "./dist/source-collector.js",
      "default": "./dist/source-collector.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@dom-xray/core": "workspace:*",
    "dom-serializer": "^3.1.1",
    "htmlparser2": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@angular-devkit/build-angular": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "@angular-devkit/build-angular": {
      "optional": true
    }
  }
}
