{
  "name": "@dom-xray/rspack",
  "version": "1.0.1",
  "description": "Rspack plugin for DOM XRay",
  "repository": {
    "type": "git",
    "url": "https://github.com/ALittleFox/dom-xray.git",
    "directory": "packages/rspack"
  },
  "keywords": [
    "dom-xray",
    "rspack",
    "plugin",
    "devtools",
    "source-code-locator",
    "source-code-navigation",
    "code-jump",
    "ai-agent"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "@rspack/core": "^2.0.0"
  },
  "devDependencies": {
    "@rspack/core": "^2.0.5",
    "typescript": "^6.0.3",
    "@types/node": "^22.15.15"
  },
  "dependencies": {
    "@dom-xray/core": "workspace:*",
    "@dom-xray/overlay-ui": "workspace:*"
  }
}
