{
  "name": "dom-xray",
  "version": "1.0.0",
  "private": true,
  "description": "A dev plugin for webpack, vite, and rspack that shows an overlay to inspect source code and submit inputs.",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint .",
    "check-types": "turbo run check-types",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "publish-packages": "changeset publish",
    "publish-all": "pnpm build && pnpm -r publish --access public",
    "dev:vite": "pnpm --filter vite-test dev",
    "dev:vite-svelte": "pnpm --filter vite-svelte-test dev",
    "dev:vite-solidjs": "pnpm --filter vite-solidjs-test dev",
    "dev:webpack": "pnpm --filter webpack-test dev",
    "dev:rspack": "pnpm --filter rspack-test dev",
    "dev:vue-cli": "pnpm --filter vue-cli-test dev",
    "dev:nextjs": "pnpm --filter nextjs-test dev",
    "dev:nuxt": "pnpm --filter nuxt-test dev",
    "dev:angular": "pnpm --filter angular-test start"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.15.15",
    "eslint": "^9.26.0",
    "turbo": "^2.5.2",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.10.0"
}
